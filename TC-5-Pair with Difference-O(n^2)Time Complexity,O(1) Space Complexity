#include <stdio.h>
int main() {
 int n, i, j, k;
 scanf("%d", &n);
 int a[n];
 for (i = 0; i < n; i++)
 scanf("%d", &a[i]);
 scanf("%d", &k);
 for (i = 0; i < n; i++) {
 for (j = i + 1; j < n; j++) {
 if (a[j] - a[i] == k || a[i] - a[j] == k) {
 printf("1");
 return 0;
 }
 }
 }
 printf("0");
 return 0;
}
