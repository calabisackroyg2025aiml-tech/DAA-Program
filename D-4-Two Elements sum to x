#include <stdio.h>
int main()
{
 int n, a[100], x;
 scanf("%d", &n);
 for (int i = 0; i < n; i++)
 scanf("%d", &a[i]);
 scanf("%d", &x);
 for (int i = 0; i < n; i++)
 {
 for (int j = i + 1; j < n; j++)
 {
 if (a[i] + a[j] == x)
 {
 printf("%d\n%d\n", a[i], a[j]);
 return 0;
 }
 }
 }
 printf("No\n");
 return 0;
}
