#include <stdio.h>
int main()
{
 int n, a[100], dp[100], max = 1;
 scanf("%d", &n);
 for (int i = 0; i < n; i++)
 scanf("%d", &a[i]);
 for (int i = 0; i < n; i++)
 {
 dp[i] = 1;
 for (int j = 0; j < i; j++)
 {
 if (a[i] >= a[j] && dp[j] + 1 > dp[i])
 dp[i] = dp[j] + 1;
 }
 if (dp[i] > max)
 max = dp[i];
 }
 printf("%d", max);
 return 0;
}
