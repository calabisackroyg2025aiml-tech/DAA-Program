#include <stdio.h>
#include <string.h>
int main()
{
 char a[1005], b[1005];
 scanf("%s %s", a, b);
 int m = strlen(a), n = strlen(b);
 int dp[1005][1005] = {0};
 for (int i = 1; i <= m; i++)
 for (int j = 1; j <= n; j++)
 {
 if (a[i - 1] == b[j - 1])
 dp[i][j] = dp[i - 1][j - 1] + 1;
 else if (dp[i - 1][j] > dp[i][j - 1])
 dp[i][j] = dp[i - 1][j];
 else
 dp[i][j] = dp[i][j - 1];
 }
 printf("%d", dp[m][n]);
 return 0;
}
