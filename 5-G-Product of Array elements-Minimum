#include <stdio.h>
int main() {
 int n, i, j, temp;
 long long sum = 0;
 scanf("%d", &n);
 int A[n], B[n];
 for (i = 0; i < n; i++)
 scanf("%d", &A[i]);
 for (i = 0; i < n; i++)
 scanf("%d", &B[i]);
 for (i = 0; i < n; i++) {
 for (j = i + 1; j < n; j++) {
 if (A[i] > A[j]) {
 temp = A[i];
 A[i] = A[j];
 A[j] = temp;
 }
 }
 }
 for (i = 0; i < n; i++) {
 for (j = i + 1; j < n; j++) {
 if (B[i] < B[j]) {
 temp = B[i];
 B[i] = B[j];
 B[j] = temp;
 }
 }
 }
 for (i = 0; i < n; i++)
 sum += (long long)A[i] * B[i];
 printf("%lld", sum);
 return 0;
}
