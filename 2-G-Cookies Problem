#include <stdio.h>
int main() {
 int n, m;
 scanf("%d", &n);
 int g[n];
 for (int i = 0; i < n; i++) {
 scanf("%d", &g[i]);
 }
 scanf("%d", &m);
 int s[m];
 for (int i = 0; i < m; i++) {
 scanf("%d", &s[i]);
 }
 for (int i = 0; i < n - 1; i++) {
 for (int j = i + 1; j < n; j++) {
 if (g[i] > g[j]) {
 int temp = g[i];
 g[i] = g[j];
 g[j] = temp;
 }
 }
 }
 for (int i = 0; i < m - 1; i++) {
 for (int j = i + 1; j < m; j++) {
 if (s[i] > s[j]) {
 int temp = s[i];
 s[i] = s[j];
 s[j] = temp;
 }
 }
 }
 int i = 0;
 int j = 0;
 int count = 0;
 while (i < n && j < m) {
 if (s[j] >= g[i]) {
 count++;
 i++;
 j++;
 } else {
 j++;
 }
 }
 printf("%d", count);
 return 0;
}
