#include <stdio.h>
int main()
{
 int n, a[100][100];
 scanf("%d", &n);
 for (int i = 0; i < n; i++)
 for (int j = 0; j < n; j++)
 scanf("%d", &a[i][j]);
 for (int i = 0; i < n; i++)
 {
 for (int j = 0; j < n; j++)
 {
 if (i > 0 && j == 0)
 a[i][j] += a[i - 1][j];
 else if (i == 0 && j > 0)
 a[i][j] += a[i][j - 1];
 else if (i > 0 && j > 0)
 {
 if (a[i - 1][j] > a[i][j - 1])
 a[i][j] += a[i - 1][j];
 else
 a[i][j] += a[i][j - 1];
 }
 }
 }
 printf("%d", a[n - 1][n - 1]);
 return 0;
}
